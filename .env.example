# Copy this file to .env. For Brevo, use smtp-relay.brevo.com, port 587,
# SMTP_SECURE=false, your Brevo SMTP login/key, and a verified sender address.
PORT=4174
NODE_ENV=development

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-username
SMTP_PASS=your-brevo-smtp-key
CONTACT_FROM=verified-sender@example.com

# Contact messages go here. Defaults to the portfolio owner's inbox if omitted.
CONTACT_TO=ebirone4@gmail.com
